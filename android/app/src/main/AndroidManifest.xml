<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 在线漫画源、登录、封面/正文取图、线路探测全靠它 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 只用来看「VPN 是不是开着」：开了就说明墙外源能连，别把它们当成坏源跳过 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.EnhanceComic">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 网页登录跑在独立进程里：主进程的源引擎 JS 桥 WebView 建在后台 Looper 线程，
             Chromium 只允许在一个线程初始化，主进程再建登录 WebView 是 native 崩溃。
             独立进程 = 全新进程，Chromium 第一次初始化就在主线程，从根上绕开。 -->
        <activity
            android:name=".WebLoginActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:label="网页登录"
            android:process=":login" />
    </application>

</manifest>
